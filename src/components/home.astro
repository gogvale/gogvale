---
import LetterGlitch from "../React/LetterGlitch.tsx";
import { links } from "../data/links";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-10 md:py-32 pb-14">
    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <div class="text-left space-y-5">
        <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
          Gabriel Oliveira
        </p>
        <div class="space-y-5">
          <h1 class="text-[var(--white)] text-4xl md:text-6xl font-medium text-pretty leading-tight">
            I build, automate, secure, and self-host things.
          </h1>
          <p class="text-base md:text-xl text-[var(--white-icon)] max-w-2xl leading-relaxed">
            Application security and automation engineer interested in cloud,
            AI, infrastructure, DevOps, homelab systems, and software that makes
            secure delivery easier.
          </p>
        </div>
        <div class="flex flex-wrap justify-start gap-3 pt-3 md:pt-5">
          <a
            target="_blank"
            href={links.github}
            class="text-[var(--white)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] px-5 py-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            GitHub
          </a>
          <a
            target="_blank"
            href={links.linkedin}
            class="text-[var(--white)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] px-5 py-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            LinkedIn
          </a>
          <a
            target="_blank"
            href={links.blog}
            class="text-[var(--background)] hover:text-[var(--background)] transition duration-300 ease-in-out border border-1 border-[var(--sec)] px-5 py-3 rounded-xl bg-[var(--sec)] hover:opacity-90"
          >
            Blog
          </a>
        </div>
      </div>

      <div class="h-[300px] md:h-[390px] rounded-xl overflow-hidden border border-[var(--white-icon-tr)]">
        <LetterGlitch
          client:load
          glitchColors={["#0ea5e9", "#7dd3fc", "#134e4a"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #7dd3fc 25%, #e0f2fe 50%, #7dd3fc 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
