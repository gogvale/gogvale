---
import { links } from "../data/links";

const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="text-[var(--white-icon)] leading-relaxed max-w-2xl">
        <p>Built with Astro and Tailwind. Deployed with GitHub Pages Actions.</p>
        <p class="text-sm mt-2">
          Gothsec/Astro-portfolio is MIT licensed; original copyright notice
          preserved below.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={links.github}
          target="_blank"
          class="text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl px-4 py-2 hover:bg-[var(--white-icon-tr)] transition"
        >
          GitHub
        </a>
        <a
          href={links.linkedin}
          target="_blank"
          class="text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl px-4 py-2 hover:bg-[var(--white-icon-tr)] transition"
        >
          LinkedIn
        </a>
        <a
          href={links.blog}
          target="_blank"
          class="text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl px-4 py-2 hover:bg-[var(--white-icon-tr)] transition"
        >
          Blog
        </a>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-sm text-[var(--white-icon)] space-y-2">
        <!-- If you are using this template, by MIT License you can't remove the copyright notice -->
        <span class="block sm:inline"
          >Copyright © {currentYear} <a href="https://github.com/Gothsec"
            >Oscar Hernandez</a
          >. Template adapted by Gabriel Oliveira.</span
        >
      </p>
    </div>
  </div>
</footer>
